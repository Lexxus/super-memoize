{
  "name": "super-memoize",
  "version": "1.1.0",
  "description": "Faster than fast, smaller than micro ... a super speed and tiny size memoizer.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.min.js",
  "jsdelivr": "./dist/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && bun run build:min && bun run build:types",
    "build:esm": "bun build ./src/index.ts --outfile ./dist/index.js --format esm --target browser",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --format cjs --minify --target node",
    "build:min": "bun build ./src/index.ts --outfile ./dist/index.min.js --format esm --minify --target browser",
    "build:types": "bun -e 'await Bun.write(\"dist/index.d.ts\", await Bun.file(\"src/index.d.ts\").text())'",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lexxus/super-memoize.git"
  },
  "keywords": [
    "memoize",
    "moize",
    "fast-memoize",
    "micro-memoize"
  ],
  "author": "Oleksii Teterin",
  "bugs": {
    "url": "https://github.com/lexxus/super-memoize"
  },
  "homepage": "https://github.com/Lexxus/super-memoize",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.4.0",
    "bun": "1.4.0"
  }
}
